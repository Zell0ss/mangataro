---
import Layout from '../layouts/Layout.astro';
import ChapterItem from '../components/ChapterItem.astro';
import { api } from '../lib/api';

const [latestChapters, unreadChapters] = await Promise.all([
  api.getLatestChapters(100),
  api.getUnreadChapters(500),
]);

const unreadCountPerManga = new Map<number, number>();
for (const ch of unreadChapters) {
  const mangaId = ch.manga_scanlator.manga.id;
  unreadCountPerManga.set(mangaId, (unreadCountPerManga.get(mangaId) || 0) + 1);
}

const mangaUpdates = latestChapters.map(ch => ({
  chapter: ch,
  manga: ch.manga_scanlator.manga,
  scanlator: ch.manga_scanlator.scanlator,
  unreadCount: unreadCountPerManga.get(ch.manga_scanlator.manga.id) || 0,
}));

// Unique scanlators present in updates, preserving order of first appearance
const scanlatorsMap = new Map<number, { id: number; name: string }>();
for (const u of mangaUpdates) {
  if (!scanlatorsMap.has(u.scanlator.id)) scanlatorsMap.set(u.scanlator.id, u.scanlator);
}
const scanlatorsList = [...scanlatorsMap.values()];
---

<Layout title="Updates - MangaTaro">
  <div
    class="max-w-5xl mx-auto"
    x-cloak
    x-data="updates"
    data-manga={JSON.stringify(mangaUpdates)}
    data-scanlators={JSON.stringify(scanlatorsList)}
  >
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-display font-extrabold tracking-tight text-ink-50">Updates</h1>
        <p class="text-ink-400 mt-1 text-sm">
          {unreadChapters.length} unread chapter{unreadChapters.length !== 1 ? 's' : ''} across {mangaUpdates.length} series
        </p>
      </div>

      {mangaUpdates.length > 0 && (
        <div class="flex flex-wrap items-center gap-3">
          <!-- Scanlator Dropdown -->
          <select
            x-model="selectedScanlator"
            class="bg-ink-800/80 border border-ink-700/40 rounded-lg px-3 py-1.5 text-xs font-semibold text-ink-300 focus:outline-none focus:ring-2 focus:ring-crimson-600/40 cursor-pointer transition"
          >
            <option value="">All scanlators</option>
            <template x-for="s in scanlatorsList" :key="s.id">
              <option :value="String(s.id)" x-text="s.name"></option>
            </template>
          </select>

          <!-- Mode Toggle -->
          <div class="flex bg-ink-800/80 rounded-lg p-1 ring-1 ring-ink-700/40">
            <button
              @click="mode = 'latest'"
              :class="mode === 'latest' ? 'bg-ink-700 text-ink-50 shadow-sm' : 'text-ink-400 hover:text-ink-200'"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all duration-200"
            >
              Latest
            </button>
            <button
              @click="mode = 'all'"
              :class="mode === 'all' ? 'bg-ink-700 text-ink-50 shadow-sm' : 'text-ink-400 hover:text-ink-200'"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all duration-200"
            >
              All Updates
            </button>
          </div>

          <!-- NSFW Toggle -->
          <label class="relative inline-flex items-center cursor-pointer">
            <input
              type="checkbox"
              class="sr-only peer"
              x-model="showNSFW"
              @change="localStorage.setItem('showNSFW', showNSFW)"
            />
            <div class="w-11 h-6 bg-ink-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-crimson-600/40 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-crimson-600"></div>
            <span class="ml-3 text-sm font-medium text-ink-300">Show NSFW</span>
          </label>
        </div>
      )}
    </div>

    {mangaUpdates.length === 0 ? (
      <div class="text-center py-24">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-ink-800/60 ring-1 ring-ink-700/30 flex items-center justify-center">
          <svg class="w-7 h-7 text-ink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <p class="text-ink-300 text-lg font-display font-semibold">All caught up</p>
        <p class="text-ink-500 text-sm mt-1">No unread chapters right now</p>
      </div>
    ) : (
      <>
        <!-- Latest per Series View (Alpine-rendered, grouped by date) -->
        <div x-show="mode === 'latest'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">

          <!-- Empty state when filters hide everything -->
          <div x-show="filteredGroups.length === 0" class="text-center py-24">
            <p class="text-ink-400 text-lg font-display font-semibold">No series match your filters</p>
          </div>

          <template x-for="group in filteredGroups" :key="group.label">
            <div class="mb-8">
              <!-- Date separator (Style A) -->
              <div class="flex items-center gap-3 mb-4">
                <span class="text-ink-400 text-xs font-semibold uppercase tracking-widest" x-text="group.label"></span>
                <div class="flex-1 h-px bg-ink-700/50"></div>
              </div>

              <!-- Cards grid -->
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                <template x-for="u in group.items" :key="u.chapter.id">
                  <a
                    :href="'/manga/' + u.manga.id"
                    class="group relative rounded-xl overflow-hidden bg-ink-800 ring-1 ring-ink-700/30 hover:ring-crimson-600/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-crimson-950/20"
                  >
                    <div class="aspect-[2/3] overflow-hidden">
                      <img
                        :src="u.manga.cover_filename ? '/data/img/' + u.manga.cover_filename : '/placeholder-cover.jpg'"
                        :alt="u.manga.title"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/30 to-transparent"></div>
                    </div>

                    <!-- Unread count badge -->
                    <div class="absolute top-2.5 right-2.5 bg-crimson-600 text-white text-[11px] font-bold px-2 py-0.5 rounded-full shadow-lg ring-2 ring-ink-800" x-text="u.unreadCount"></div>

                    <!-- Scanlator badge (visible when "All scanlators" selected) -->
                    <div
                      x-show="!selectedScanlator"
                      class="absolute top-2.5 left-2.5 bg-ink-900/80 text-ink-300 text-[10px] font-semibold px-1.5 py-0.5 rounded-md ring-1 ring-ink-700/40 truncate max-w-[calc(100%-2.5rem)]"
                      x-text="u.scanlator.name"
                    ></div>

                    <!-- Info Overlay -->
                    <div class="absolute bottom-0 left-0 right-0 p-3">
                      <h3 class="font-display font-semibold text-ink-50 line-clamp-2 text-sm leading-snug" x-text="u.manga.title"></h3>
                      <p class="text-crimson-400 text-xs font-semibold mt-1" x-text="'Ch. ' + u.chapter.chapter_number"></p>
                      <p class="text-ink-400 text-[11px] mt-0.5" x-text="timeAgo(u.chapter.detected_date)"></p>
                    </div>
                  </a>
                </template>
              </div>
            </div>
          </template>
        </div>

        <!-- All Updates View (SSR-rendered, client-side filtered) -->
        <div x-show="mode === 'all'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
          <div class="space-y-2">
            {unreadChapters.map((chapter) => (
              <div
                x-show="isVisibleEl($el)"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                data-nsfw={String(chapter.manga_scanlator.manga.nsfw)}
                data-scanlator-id={String(chapter.manga_scanlator.scanlator.id)}
              >
                <ChapterItem chapter={chapter} />
              </div>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('updates', () => ({
      mode: 'latest',
      showNSFW: localStorage.getItem('showNSFW') === 'true',
      selectedScanlator: '',
      allManga: [] as any[],
      scanlatorsList: [] as any[],

      init() {
        this.allManga = JSON.parse((this.$el as HTMLElement).dataset.manga || '[]');
        this.scanlatorsList = JSON.parse((this.$el as HTMLElement).dataset.scanlators || '[]');
      },

      // For SSR-rendered "All Updates" items (checks data attributes)
      isVisibleEl(el: HTMLElement) {
        const nsfw = el.dataset.nsfw === 'true';
        const nsfwOk = this.showNSFW || !nsfw;
        const scanlatorOk = !this.selectedScanlator || el.dataset.scanlatorId === this.selectedScanlator;
        return nsfwOk && scanlatorOk;
      },

      // For Alpine-rendered "Latest" items
      isVisible(u: any) {
        const nsfwOk = this.showNSFW || !u.manga.nsfw;
        const scanlatorOk = !this.selectedScanlator || String(u.scanlator.id) === this.selectedScanlator;
        return nsfwOk && scanlatorOk;
      },

      get filteredGroups() {
        const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
        const now = new Date();
        const today = startOfDay(now);
        const yesterday = today - 86400000;
        const weekAgo = today - 7 * 86400000;
        const monthAgo = today - 30 * 86400000;

        const buckets: { label: string; items: any[] }[] = [
          { label: 'Today', items: [] },
          { label: 'Yesterday', items: [] },
          { label: 'Last 7 days', items: [] },
          { label: 'Last 30 days', items: [] },
          { label: 'Older', items: [] },
        ];

        for (const u of this.allManga) {
          if (!this.isVisible(u)) continue;
          const d = startOfDay(new Date(u.chapter.detected_date));
          if (d >= today) buckets[0].items.push(u);
          else if (d >= yesterday) buckets[1].items.push(u);
          else if (d >= weekAgo) buckets[2].items.push(u);
          else if (d >= monthAgo) buckets[3].items.push(u);
          else buckets[4].items.push(u);
        }

        return buckets.filter(b => b.items.length > 0);
      },

      timeAgo(dateString: string) {
        const seconds = Math.floor((Date.now() - new Date(dateString).getTime()) / 1000);
        const intervals: [string, number][] = [
          ['year', 31536000], ['month', 2592000], ['week', 604800],
          ['day', 86400], ['hour', 3600], ['minute', 60],
        ];
        for (const [unit, s] of intervals) {
          const n = Math.floor(seconds / s);
          if (n >= 1) return `${n} ${unit}${n > 1 ? 's' : ''} ago`;
        }
        return 'just now';
      },
    }));
  });
</script>
